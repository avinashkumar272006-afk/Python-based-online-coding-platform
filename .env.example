# ==============================================================================
# Environment Configuration Template
# Copy this file to .env or configure in your operating system / container environment.
# Never commit real credentials, production passwords, or sensitive keys to source control.
# ==============================================================================

# Application Environment: TEST, LOCAL_DEV, STAGING, PRODUCTION
# Defaults to UNKNOWN if omitted, blank, or unrecognized.
APP_ENV=LOCAL_DEV

# Database Configuration (PostgreSQL / Supabase)
DB_URL=jdbc:postgresql://localhost:5432/coding_platform
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Optional HikariCP Pool Configuration
DB_POOL_NAME=PythonCodingPlatformPool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
